{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "業務画面(Python が返す画面)から呼んでよいもの。帳票・印刷ビューの窓を開く・閉じる・社内サイト(包装仕様書の閲覧システム)を既定のブラウザで開く だけ",
  "windows": ["main", "report-*"],
  "remote": {
    "urls": ["http://app.localhost/*", "app://localhost/*"]
  },
  "permissions": ["core:default"]
}
